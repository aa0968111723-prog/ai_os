{
  "id": "/",
  "name": "Aios",
  "short_name": "Aios",
  "description": "Aios — AI 創作作業系統",
  "lang": "zh-Hant",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#e9e3d8",
  "theme_color": "#e9e3d8",
  "categories": ["productivity", "business", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "video/*", "audio/*", "application/pdf"] }
      ]
    }
  },
  "icons": [
    { "src": "/icons/icon-v2-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-v2-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-v2-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-v2-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-v2-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-v2-1024-maskable.png", "sizes": "1024x1024", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "作業台", "short_name": "作業台", "description": "回到專案作業台", "url": "/?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-v2-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "筆記排程", "short_name": "排程", "description": "開啟筆記排程", "url": "/planner?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-v2-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "資料庫", "short_name": "資料庫", "description": "開啟資料庫", "url": "/databases?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-v2-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "私訊", "short_name": "私訊", "description": "開啟站內私訊", "url": "/chat?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-v2-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
