<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深層連結：分享/通知裡的 https://ai-os-app.zeabur.app/* 直接開 App
                 （側載 App 無法 App Links 驗證 assetlinks，故不設 autoVerify；
                 使用者首次點擊會出現「用哪個應用程式開啟」選單，屬預期行為） -->
            <!-- autoVerify：assetlinks.json 端點就緒（設定 ANDROID_APPLINK_SHA256）後
                 驗證通過即直開 App；未設定時驗證失敗→連結開瀏覽器，行為與先前相同 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ai-os-app.zeabur.app" />
            </intent-filter>

            <!-- aios:// 自訂 scheme（App 在場表面專用：Widget／捷徑；分享一律仍發 https。
                 MainActivity 白名單轉譯成同站 https，走 Capacitor 既有深連結路徑） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aios" />
            </intent-filter>

        </activity>

        <!-- 長按 App 圖示的捷徑：直接進語音或任務（見 res/xml/shortcuts.xml） -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!--
            桌面 Orb Widget。

            exported="false"：這個 receiver 只接系統的 APPWIDGET_UPDATE 廣播與
            自家 App 的更新呼叫，沒有任何理由讓別的 App 叫得動它。
            注意 Widget **不需要任何額外權限**——它不上網、不讀資料，
            只顯示 App 寫進 SharedPreferences 的狀態（任務書 §9 的紅線：
            核心功能不得依賴 SYSTEM_ALERT_WINDOW 之類的高風險權限）。
        -->
        <receiver
            android:name=".OrbWidgetProvider"
            android:label="@string/orb_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aios_orb_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AiosSpeech（系統 SpeechRecognizer）：執行期仍要使用者同意；辨識在裝置端，音訊不上傳 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 套件可見性：少了這段 SpeechRecognizer.isRecognitionAvailable 恆 false，
         按住 Orb 會靜默退化成打字，而且只在實機上看得出來 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
