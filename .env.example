# ── AI Director OS 環境變數 ─────────────────────────────
# 全部部署在 Railway（定案）：App 服務 + Postgres 服務

# Railway Postgres 連線字串（Railway 會自動注入；本機開發填自己的）
DATABASE_URL=postgres://user:password@localhost:5432/aidirector

# Fal.ai 金鑰【必填】（媒體生成：圖像/影片/音訊/視覺理解/轉錄/訓練走 Fal）
# 全站一律真實模式：沒填金鑰生成會回明確錯誤並自動退點（示範模式已移除）
FAL_KEY=

# ⚠ 僅供自動化測試（CI 六套 e2e）：=1 全站假生成不花錢；正式部署絕不設定
E2E_MOCK=

# 測試模式下也「真扣點」（搭配 E2E_MOCK=1，e2e 驗證額度守門用；正式模式永遠扣點）
MOCK_BILLING=

# ── NVIDIA NIM（LLM 文字生成：導演/助手/彙總/生成台 LLM 類整站走 NIM）───
# API 金鑰（build.nvidia.com 取得）；沒填 → 真實模式下 LLM 功能回明確錯誤並退點
NVIDIA_NIM_API_KEY=
# NIM 端點；空=https://integrate.api.nvidia.com/v1（自架 NIM 微服務時才需要改）
NVIDIA_NIM_ENDPOINT=
# 後端自動 LLM（導演/助手/彙總）的模型；空=meta/llama-3.1-70b-instruct。
# 換模型先在真實模式抽測導演建議/拆分鏡/助手問答的 JSON 輸出穩定性（見 docs/維運手冊.md）
NVIDIA_NIM_MODEL=

# 點數預算「初始值」（1 點 ≈ NT$1 參考）——只在首次啟動寫入資料庫，
# 之後一律在系統「團隊管理→點數與額度」由管理員/組長調整（不鎖死；空=不限）
TOTAL_BUDGET_POINTS=5000
WEEKLY_QUOTA_POINTS=300

# ── 認證（登入・團隊・組別）───────────────────────
# 種子開發者帳號（首次啟動自動建立；程式內建預設 aa0968111723@gmail.com——
# 設這兩個變數即可覆蓋，這也是「忘記密碼」的萬能自救路徑：改變數→Redeploy）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 【production 必填】限流識別鍵的 HMAC-SHA-256 金鑰，至少 32 字元；email/IP 原文不落 DB。
# 需跨 replicas 共用且跨重啟保持不變；輪替會讓既有限流桶自然失聯（等同清空短期窗口）。
# 可用：openssl rand -hex 32
RATE_LIMIT_SECRET=
# AUTH_MODE=dev 可跳過登入（自動以開發者身分，只限開發測功能）
AUTH_MODE=
# 對外網址（邀請連結用；Railway 部署後填正式網址）
APP_URL=http://localhost:5173

# MCP 舊共用超管金鑰（僅本機／CI 相容；NODE_ENV=production 時程式會忽略）。
# 即使在非 production 也必須另外明確設 ALLOW_LEGACY_MCP_ADMIN_KEY=1；預設關閉。
# 正式站請在「接上外部 AI」建立可撤銷、可到期、綁定個人的連線金鑰。
MCP_API_KEY=
ALLOW_LEGACY_MCP_ADMIN_KEY=

# ── Google 整合（選用）：日曆直連同步＋個人 Google 雲端匯入（docs/Google日曆同步.md、docs/整合連接.md）──
# GCP OAuth 用戶端；redirect URI 需註冊兩條：{APP_URL}/api/google/oauth/callback（日曆）
# 與 {APP_URL}/api/integrations/google-drive/callback（雲端匯入，另需啟用 Drive API）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 日曆 refresh token 加密金鑰種子（選）；空=退回 GOOGLE_CLIENT_SECRET
GOOGLE_TOKEN_SECRET=

# ── 個人整合連接（docs/整合連接.md）──────────────────
# 憑證（Google 雲端/Notion/外部 API）加密金鑰種子（選）；
# 空=系統在 Volume 自動產生持久金鑰檔 .integration-key（換 Volume 記得一併搬）
INTEGRATION_TOKEN_SECRET=
# 站方共用 Notion 整合 token（選）；使用者也可在「整合連接」頁自設個人 token（優先）
NOTION_TOKEN=

# ── 信箱機制（選用）：回饋代理寄信回覆回報者、以及邀請成員時寄邀請連結給對方 ───
# 走 Resend HTTP API（https://resend.com）；兩個都要設才會「實際寄出」。
# 未設定＝優雅降級：回饋代理照常落地回覆草稿、邀請照常產生連結，只是不寄信（改用複製連結）。
# RESEND_API_KEY：Resend 後台建立的 API Key
RESEND_API_KEY=
# EMAIL_FROM：寄件人（需為 Resend 已驗證網域的地址），如 "AI Director OS <noreply@your-domain.com>"
EMAIL_FROM=

# ── 跨裝置通知（Web Push，選用）────────────────────
# 全部不設也能用：首次啟動自動生成 VAPID 金鑰對並存資料庫（跨重啟穩定）。
# 只有要「自帶金鑰」或多環境共用同一對時才設；⚠ 換金鑰＝既有已連結裝置要等
# 各自下次開 App 由例行同步自動換訂，期間收不到推播。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID 主張（推送服務要求 mailto: 或 https: 網址）；空=沿用 EMAIL_FROM 的位址
VAPID_SUBJECT=

# 伺服器埠（Railway 自動注入 PORT）
PORT=3000
