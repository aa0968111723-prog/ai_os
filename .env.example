# === 核心 ===
DATABASE_URL=postgres://user:pass@localhost:5432/ai_os
SESSION_SECRET=change-me-to-a-long-random-string

# === 素材保全（P0）===
# 簽名用密鑰（建議隨機長字串）；不設也能跑，但建議設
ASSET_SIGN_SECRET=
# 設成 1 時，儲存異常會直接拒收新素材（預設只警告不擋）
ASSET_STRICT=0
# 給排程／外部工具下載素材備份用的 token（Bearer）
ADMIN_BACKUP_TOKEN=

# === 其他 ===
FAL_KEY=
OPENAI_API_KEY=
