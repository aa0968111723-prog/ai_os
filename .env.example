# ── AI Director OS 環境變數 ─────────────────────────────
# 全部部署在 Railway（定案）：App 服務 + Postgres 服務

# Railway Postgres 連線字串（Railway 會自動注入；本機開發填自己的）
DATABASE_URL=postgres://user:password@localhost:5432/aidirector

# Fal.ai 金鑰（定案：一切以 Fal 為主）
# 沒填金鑰 → 自動進「假生成模式」：不花錢就能測完整流程
FAL_KEY=

# 強制假生成模式（就算有金鑰也不花錢，開發測試用）
FAL_MOCK=1

# 點數預算（1 點 ≈ NT$1）
TOTAL_BUDGET_POINTS=5000
WEEKLY_QUOTA_POINTS=300

# ── 認證（登入・團隊・組別）───────────────────────
# 種子超管帳號（首次啟動自動建立；密碼未設則隨機產生並印在 log 一次）
SEED_ADMIN_EMAIL=admin@aidirector.local
SEED_ADMIN_PASSWORD=
# AUTH_MODE=dev 可跳過登入（自動以超管身分，只限開發測功能）
AUTH_MODE=
# 對外網址（邀請連結用；Railway 部署後填正式網址）
APP_URL=http://localhost:5173

# 伺服器埠（Railway 自動注入 PORT）
PORT=3000
