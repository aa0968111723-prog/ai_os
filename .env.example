# ── AI Director OS 環境變數 ─────────────────────────────
# 現行部署平台為 Zeabur：App 服務 + PostgreSQL 服務 + 掛在 App /data 的 Volume
#（2026-07 前在 Railway；程式碼本身平台中立，路徑與網址都由下面的變數決定）

# PostgreSQL 連線字串（Zeabur 用變數參照引用同專案的 PostgreSQL 服務；本機開發填自己的）
DATABASE_URL=postgres://user:password@localhost:5432/aidirector

# PostHog browser analytics（Vite 僅公開 VITE_ 前綴變數；請在部署平台填入專案值）
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Fal.ai 金鑰【必填】（媒體生成，以及 AI 代理選用 Fal／NIM 自動備援時的 LLM 規劃）
# 全站一律真實模式：沒填金鑰生成會回明確錯誤並自動退點（示範模式已移除）
FAL_KEY=

# 可選。查 Fal 帳戶 credits（管理頁「Fal 帳戶」）需 Admin scope。
# 未設時後端會嘗試 FAL_KEY；若無權限則 UI 顯示「需 Admin Key」。
# 僅後端環境注入，永不下發 client。見 docs/product/fal-balance-and-personal-usage-plan.md
# FAL_ADMIN_KEY=

# Fal 模型目錄／價格會在開機同步，之後定期更新；以下皆可選，不填即使用安全預設。
# 每次掃描的新模型頁數（預設 2，0＝只更新既有目錄價格）
LIVE_MODEL_DISCOVER_PAGES=2
# 同步週期毫秒（預設 21600000＝6 小時；0＝關閉週期同步，仍會在開機同步一次）
LIVE_MODEL_SYNC_INTERVAL_MS=21600000

# ⚠ 僅供自動化測試（CI 六套 e2e）：=1 全站假生成不花錢；正式部署絕不設定
E2E_MOCK=

# 測試模式下也「真扣點」（搭配 E2E_MOCK=1，e2e 驗證額度守門用；正式模式永遠扣點）
MOCK_BILLING=

# ── NVIDIA NIM（一般 LLM 文字生成；AI 代理可由使用者改選 Fal 或使用自動備援）───
# API 金鑰（build.nvidia.com 取得）；沒填 → 真實模式下 LLM 功能回明確錯誤並退點
NVIDIA_NIM_API_KEY=
# NIM 端點；空=https://integrate.api.nvidia.com/v1（自架 NIM 微服務時才需要改）
NVIDIA_NIM_ENDPOINT=
# 後端自動 LLM（導演/助手/彙總）的模型；空=meta/llama-3.1-70b-instruct。
# 換模型先在真實模式抽測導演建議/拆分鏡/助手問答的 JSON 輸出穩定性（見 docs/維運手冊.md）
NVIDIA_NIM_MODEL=
# 高階（旗艦）模型：只給劇本解析這種「一份稿子跑一次、錯了整條下游都歪掉」的深度分析用；
# 空=meta/llama-3.1-405b-instruct。這顆不可用時會自動降級為上面那顆，解析不會整個失敗
NVIDIA_NIM_REASONING_MODEL=

# Intelligence Library external analysis is opt-in to prevent surprise background cost.
# Without this flag, ingestion uses the deterministic local provider even when AI keys exist.
INTELLIGENCE_EXTERNAL_ANALYSIS_ENABLED=0
# auto | local | fal | nim. auto uses Fal for supported media and NIM for text when configured.
INTELLIGENCE_ANALYSIS_PROVIDER=auto
INTELLIGENCE_VISION_MODEL_ID=fal-ai/any-llm/vision#gemini-2.5-flash
INTELLIGENCE_TRANSCRIPTION_MODEL_ID=fal-ai/whisper
# Optional; defaults to NVIDIA_NIM_MODEL.
INTELLIGENCE_TEXT_MODEL_ID=
# Optional internal capability services. Both must return JSON and must never infer real identities.
INTELLIGENCE_FACE_PROVIDER_URL=
INTELLIGENCE_VIDEO_PROVIDER_URL=
INTELLIGENCE_CAPABILITY_TOKEN=
# Background ingestion throughput per 5-second tick (1-32).
INTELLIGENCE_JOBS_PER_TICK=8

# 點數預算「初始值」（1 點 ≈ NT$1 參考）——只在首次啟動寫入資料庫，
# 之後一律在系統「團隊管理→點數與額度」由管理員/組長調整（不鎖死；空=不限）
TOTAL_BUDGET_POINTS=5000
WEEKLY_QUOTA_POINTS=300

# ── 認證（登入・團隊・組別）───────────────────────
# 種子開發者帳號（首次啟動自動建立；程式內建預設 aa0968111723@gmail.com——
# 設這兩個變數即可覆蓋，這也是「忘記密碼」的萬能自救路徑：改變數→Redeploy）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 【production 必填】限流識別鍵的 HMAC-SHA-256 金鑰，至少 32 字元；email/IP 原文不落 DB。
# 需跨 replicas 共用且跨重啟保持不變；輪替會讓既有限流桶自然失聯（等同清空短期窗口）。
# 可用：openssl rand -hex 32
RATE_LIMIT_SECRET=
# AUTH_MODE=dev 可跳過登入（自動以開發者身分，只限開發測功能）
AUTH_MODE=
# 對外網址（邀請連結／素材簽名網址用；正式站必填 https://你的網域）
# 未設時退 PUBLIC_DOMAIN／RAILWAY_PUBLIC_DOMAIN，再退 localhost（正式站勿依賴後者）
APP_URL=http://localhost:5173
# PUBLIC_DOMAIN=ai-os-app.zeabur.app

# MCP 舊共用超管金鑰（僅本機／CI 相容；NODE_ENV=production 時程式會忽略）。
# 即使在非 production 也必須另外明確設 ALLOW_LEGACY_MCP_ADMIN_KEY=1；預設關閉。
# 正式站請在「接上外部 AI」建立可撤銷、可到期、綁定個人的連線金鑰。
MCP_API_KEY=
ALLOW_LEGACY_MCP_ADMIN_KEY=

# ── 素材儲存（上傳檔與生成成品）────────────────────────
# 素材的「實體檔」存在掛載的 Volume 上，資料庫只記相對路徑——所以備份要成對做、還原也要成對還原
#（做法見 docs/維運手冊.md 第二章）。這一區沒設好的後果都不是報錯，而是「哪天重佈之後圖全變破圖」。

# 素材儲存根目錄。空＝自動判定：/data 若是「真正的掛載點」就用它，否則退回專案下的 ./.data。
# 不設會怎樣：Volume 正常掛在 /data 的站台不用設。但若 Volume 掛在別的路徑又沒設這個變數，
# 檔案會寫進容器本地磁碟，下次重新部署整批消失（系統會亮紅警告，但檔案救不回來）。
ASSET_DIR=

# 持久性宣告（覆寫自動偵測）：1＝我確定這個路徑是持久卷；0＝明確宣告它非持久。
# 空＝自動偵測（比對儲存根目錄與其父目錄是否位於不同裝置，藉此判斷是不是掛載點；
# 不再只看「目錄存不存在」——映像本身就帶了空的 /data，只看存在等於永遠假綠燈）。
# 不設會怎樣：正常情況不用設，自動偵測即可。只有在平台掛載方式特殊、明明掛了卷卻被誤判成
# 非持久（全站紅色橫幅、/api/ready 亮紅）時才設 1；設 0 則反過來，用於本機刻意演練警示流程。
ASSET_PERSISTENT=

# 嚴格模式：1＝偵測到儲存非持久／不可寫／Volume 被換掉時，直接拒收新素材
#（上傳與生成成品落地都會回一句中文說明，告訴使用者現在不能存、該找誰處理）。
# 不設會怎樣：預設只警告不攔（空/0）。好處是誤判不會讓一個正常站台變成唯讀，
# 代價是真的沒掛卷時，這段期間新增的素材下次重佈就沒了。很在意資料的正式站建議設 1。
ASSET_STRICT=

# 上傳單檔上限 MB。空＝200。
# 不設會怎樣：超過此上限的上傳會被擋。Volume 擴容後把這裡調大即可，不用改程式。
ASSET_MAX_MB=

# AI 成品落地上限 MB（把 fal CDN 抓回 Volume）。空＝2000。
# 與 ASSET_MAX_MB 分開：使用者上傳仍受上傳上限約束；付費長片成品盡量落進 Volume，避免 CDN 過期死連結。
# 不設會怎樣：用 2000MB 預設。更大成片可再調高，並確認 Volume 空間夠。
ASSET_AI_MAX_MB=

# 素材簽名網址（給 fal 抓「來源輸入」用的短效網址）的 HMAC 金鑰，至少 32 字元。
# 可用：openssl rand -hex 32
# 不設會怎樣：每次重啟隨機生成一把 → 重啟／重新部署的瞬間，所有在途簽名網址立刻作廢，
# 正在排隊的生成會抓不到來源素材而失敗。正式站設一次，之後永遠不要換。
ASSET_SIGN_SECRET=

# 生成成品「落地」（把 fal CDN 的檔案抓回 Volume 永久保存）失敗時的最大重試次數。
# 空＝用程式內建預設值（見 server/services/generationCore.ts）。
# 不設會怎樣：用預設即可。調小＝壞掉的來源早點放棄，不佔補抓名額；調大＝在外部網址過期前多試幾次。
# 目前還有多少素材沒落地，看系統自檢的「未落地素材」那一項。
ASSET_LAND_MAX_ATTEMPTS=

# ── 物件儲存（S3 相容：MinIO／Cloudflare R2／AWS S3）─────────
# 設了 S3_ENDPOINT（或 MINIO_ENDPOINT）＋bucket＋金鑰就自動啟用，素材改存物件儲存、不再寫本機磁碟；
# 上面那一整區 Volume 相關的持久性判定與紅色警示會自動停用（素材根本不在這台機器上）。
# 兩種後端的相對路徑（資料庫的 storage_path）完全相同，所以切換不用改資料庫。
#
# ⚠ 切換前務必先搬舊檔，否則站上所有舊圖／舊旁白／舊成片會在切換當下集體變 404：
#   1) 先設好下面的變數但「先不要重啟服務」
#   2) DATABASE_URL=... ASSET_DIR=/data npm run assets:migrate-object-store
#   3) 重啟服務（此時才切到物件儲存）
#   4) 再跑一次步驟 2，補上這中間新產生的檔案
#   5) npm run assets:verify 確認沒有缺檔，之後才可以把 Volume 退掉
#
# 端點（不含 bucket）。內網 MinIO 沒帶 scheme 時自動補 http://；對外網域請自己寫 https://
# S3_ENDPOINT=http://minio.internal:9000
# bucket 名稱（必須先建好，本服務不會自動建立）
# S3_BUCKET=aidos-assets
# 金鑰。自架 MinIO 也可直接用 MINIO_ROOT_USER／MINIO_ROOT_PASSWORD 這組名字，不必改名
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 區域。MinIO 隨便填都可以（只影響簽章）；AWS S3 要填實際區域。空＝us-east-1
# S3_REGION=us-east-1
# path-style 定址（bucket 放在路徑而不是子網域）。MinIO 必須 1；AWS S3／R2 可設 0。空＝1
# S3_FORCE_PATH_STYLE=1
# 共同前綴：多個環境（正式／測試）共用同一個 bucket 時用來隔離。空＝不加前綴
# S3_PREFIX=
#
# ⚠ 用物件儲存時 INTEGRATION_TOKEN_SECRET 變成必填（見上面的認證區塊）：
# Google／Notion 的 token 金鑰種子預設寫在 STORAGE_ROOT/.integration-key，
# 沒有 Volume 時那個檔案每次部署都會重生，已連結的帳號會全部失效且救不回來。
# ⚠ 另外 /api/admin/backup/assets.tar.gz 在此模式下會回錯誤（它打包的是本機目錄，切換後是空的）——
# 請改用 bucket 版本控管／跨區複寫，或 mc mirror／aws s3 sync。詳見 docs/物件儲存與Redis.md

# ── Redis（可選：跨實例快取與即時協作同步）──────────────
# 不設會怎樣：完全正常，單一實例部署本來就不需要 Redis。只是——
#   1) 匯率／Fal 餘額之類的外部查詢快取變成「每個實例各存一份」，多打幾次外部 API；
#   2) 開到兩個以上 replica 時，同一專案的協作者若被分流到不同實例會「互相看不見」
#      （沒有游標、沒有在場名單、對方改了東西畫面也不會刷新）。
# 設了就兩者都解決。Redis 連不上時系統會自動退回單機模式，不會讓站台掛掉。
# 限流不走 Redis（那是 PostgreSQL 交易＋advisory lock 的 fail-closed 設計，刻意不動）。
# REDIS_URL=redis://:password@redis.internal:6379/0
# 多環境共用同一台 Redis 時的 key 前綴。空＝aidos
# REDIS_PREFIX=

# 素材備份下載端點 GET /api/admin/backup/assets.tar.gz 的存取權杖，給外部排程 curl 用：
#   curl -H "Authorization: Bearer $ADMIN_BACKUP_TOKEN" https://你的網域/api/admin/backup/assets.tar.gz -o assets.tar.gz
# 開發者在系統內（團隊管理頁「立即下載素材備份」）不需要這個變數，走的是登入身分。
# 不設會怎樣：素材備份只能人工手動下載，沒有自動排程＝「上次備份是什麼時候」全憑記憶。
# ⚠ 這把權杖等同「整包素材下載權」，外洩＝全站素材被拿走。只放部署平台 Variables，絕不進 git。
ADMIN_BACKUP_TOKEN=

# ── Google 整合（選用）：日曆直連同步＋個人 Google 雲端匯入（docs/Google日曆同步.md、docs/整合連接.md）──
# GCP OAuth 用戶端；redirect URI 需註冊兩條：{APP_URL}/api/google/oauth/callback（日曆）
# 與 {APP_URL}/api/integrations/google-drive/callback（雲端匯入，另需啟用 Drive API）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 日曆 refresh token 加密金鑰種子（選）；空=退回 GOOGLE_CLIENT_SECRET
GOOGLE_TOKEN_SECRET=

# ── 個人整合連接（docs/整合連接.md）──────────────────
# 憑證（Google 雲端/Notion/外部 API）加密金鑰種子（選）；
# 空=系統在 Volume 自動產生持久金鑰檔 .integration-key（換 Volume 記得一併搬）
INTEGRATION_TOKEN_SECRET=
# 站方共用 Notion 整合 token（選）；使用者也可在「整合連接」頁自設個人 token（優先）
NOTION_TOKEN=

# ── 信箱機制（選用）：回饋代理寄信回覆回報者、以及邀請成員時寄邀請連結給對方 ───
# 走 Resend HTTP API（https://resend.com）；兩個都要設才會「實際寄出」。
# 未設定＝優雅降級：回饋代理照常落地回覆草稿、邀請照常產生連結，只是不寄信（改用複製連結）。
# RESEND_API_KEY：Resend 後台建立的 API Key
RESEND_API_KEY=
# EMAIL_FROM：寄件人（需為 Resend 已驗證網域的地址），如 "AI Director OS <noreply@your-domain.com>"
EMAIL_FROM=

# ── 跨裝置通知（Web Push，選用）────────────────────
# 全部不設也能用：首次啟動自動生成 VAPID 金鑰對並存資料庫（跨重啟穩定）。
# 只有要「自帶金鑰」或多環境共用同一對時才設；⚠ 換金鑰＝既有已連結裝置要等
# 各自下次開 App 由例行同步自動換訂，期間收不到推播。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID 主張（推送服務要求 mailto: 或 https: 網址）；空=沿用 EMAIL_FROM 的位址
VAPID_SUBJECT=

# 伺服器埠（Zeabur 會自動注入 PORT，不用自己設；本機開發才需要）
PORT=3000
