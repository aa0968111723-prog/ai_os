{
  "name": "ai-director-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Director OS — 弘法內容創作與協作系統（釋迦牟尼佛救世基金會內部工具）",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "sh scripts/start.sh",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:ui-primitives": "node scripts/check-ui-primitives.mjs",
    "check:hooks": "node scripts/check-hooks-after-return.mjs",
    "report:ui-primitives": "node scripts/check-ui-primitives.mjs --report",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/db/check.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:dry-run": "tsx scripts/db/migrate.ts --dry-run",
    "db:adopt": "tsx scripts/db/adopt.ts",
    "db:adopt:dry-run": "tsx scripts/db/adopt.ts --dry-run",
    "rescue:login": "tsx scripts/db/rescue-login.ts",
    "report:orphans": "tsx scripts/report-schema-orphans.ts",
    "community:reclassify": "tsx scripts/reclassify-community.ts",
    "assets:verify": "tsx scripts/verify-asset-integrity.ts",
    "assets:migrate-object-store": "tsx scripts/migrate-assets-to-object-store.ts",
    "assets:styles": "node scripts/optimize-style-images.mjs",
    "assets:backup": "bash scripts/backup-assets.sh",
    "models:contracts": "tsx scripts/sync-model-contracts.ts",
    "models:contracts:openapi": "tsx scripts/sync-model-contracts.ts --openapi",
    "models:thumbnails": "tsx scripts/sync-model-thumbnails.ts",
    "models:docs": "tsx scripts/gen-model-docs.ts && tsx scripts/verify-models.ts",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:client:coverage": "vitest run --config vitest.client.config.ts --coverage",
    "test:ui:routes": "node scripts/e2e-ui/audit-routes.mjs",
    "test:e2e:command-center": "node scripts/e2e-ui/verify-command-center.mjs",
    "test:e2e:agent-handoffs": "node scripts/e2e-ui/verify-agent-ui-handoffs.mjs",
    "test:e2e:phone-action-first": "node scripts/e2e-ui/verify-phone-action-first.mjs",
    "test:e2e:phone-animation-repair": "node scripts/e2e-ui/verify-phone-animation-repair.mjs",
    "verify:agent-live": "python scripts/e2e-agent-live-certification.py",
    "test:e2e:animation-consistency": "bash scripts/run-animation-consistency.sh",
    "verify:agent-db-integrity": "tsx scripts/verify-agent-db-integrity.ts",
    "verify:agent-db-recovery": "tsx scripts/verify-agent-db-recovery.ts",
    "verify:database-runtime": "tsx scripts/verify-database-runtime.ts",
    "backend:doctor": "tsx scripts/backend-doctor.ts",
    "verify:gemini": "tsx scripts/verify-gemini-runtime.ts",
    "test:agent:soak": "tsx scripts/agent-v5-soak.ts",
    "test:all": "npm test && npm run test:client:coverage",
    "audit:high": "npm audit --audit-level=high",
    "check:agent-planner": "tsx scripts/check-agent-planner.ts",
    "scan:agent-integrity": "tsx scripts/scan-agent-integrity.ts",
    "soak:agent": "tsx scripts/agent-soak-harness.ts",
    "soak:agent-db": "tsx scripts/agent-db-soak.ts",
    "test:watch": "vitest",
    "sentinel": "tsx scripts/run-sentinel.ts",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@2 build",
    "icons:add": "node scripts/add-icon.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/noto-serif-tc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@huggingface/tokenizers": "^0.1.3",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/compression": "^1.8.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clip-bpe-js": "^0.0.6",
    "compression": "^1.8.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "html2canvas-pro": "^2.3.3",
    "mammoth": "^1.12.1",
    "mediabunny": "^1.53.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "posthog-js": "^1.415.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "^2.2.1",
    "tsx": "^4.23.12",
    "undici": "^8.7.0",
    "web-push": "^3.6.7",
    "wouter": "^3.3.5",
    "ws": "^8.21.3",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.31.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
